@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4 py-md-5">

    <!-- Page Header -->
    <section class="rounded-4 p-4 p-md-5 mb-4 text-white"
             style="background: linear-gradient(120deg, #081e3d, #1553a1);">

        <p class="text-uppercase fw-bold small mb-2"
           style="letter-spacing: 1.5px; color: #79d9ff;">
            Your Privacy Matters
        </p>

        <h1 class="display-6 fw-bold mb-3">
            Privacy Policy
        </h1>

        <p class="lead mb-0">
            Learn how Tsebe CareerPrep handles personal
            information and protects your interview
            preparation experience.
        </p>
    </section>

    <!-- Introduction -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h2 class="h4 fw-bold mb-3">
                Our Commitment to Privacy
            </h2>

            <p>
                Tsebe CareerPrep is an interview preparation
                platform designed to help users practise
                interview questions, review their responses
                and monitor their progress.
            </p>

            <p class="mb-0">
                This policy explains how personal information
                may be collected, used, stored and protected
                when using the platform. It is intended to
                support transparency and responsible
                information handling in accordance with
                applicable South African privacy legislation,
                including the Protection of Personal
                Information Act (POPIA).
            </p>

        </div>
    </div>

    <!-- Privacy Sections -->
    <div class="row g-4">

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        1. Information We Collect
                    </h2>

                    <p>
                        Depending on how you use the platform,
                        information may include:
                    </p>

                    <ul class="mb-0">
                        <li>Account email address and user identifier</li>
                        <li>Interview questions and submitted answers</li>
                        <li>Interview sessions and completion records</li>
                        <li>Practice history and progress statistics</li>
                        <li>Authentication and account security information</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        2. How Information Is Used
                    </h2>

                    <p>
                        Information is processed to support
                        the platform's functions, including:
                    </p>

                    <ul class="mb-0">
                        <li>Creating and authenticating accounts</li>
                        <li>Managing interview practice sessions</li>
                        <li>Saving submitted interview responses</li>
                        <li>Displaying feedback and suggested answers</li>
                        <li>Tracking interview activity and progress</li>
                        <li>Maintaining platform security and reliability</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        3. Interview Assessment and Feedback
                    </h2>

                    <p>
                        Tsebe CareerPrep currently uses
                        predefined interview questions,
                        suggested answers and rule-based
                        concept detection to provide
                        learning feedback.
                    </p>

                    <p>
                        Concept coverage indicates whether
                        expected phrases or concepts were
                        detected in a submitted response.
                        It does not independently establish
                        technical correctness or represent
                        a formal interview score.
                    </p>

                    <p class="mb-0">
                        The current assessment process does
                        not require an external paid AI
                        assessment service.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        4. Data Storage and Security
                    </h2>

                    <p>
                        The application uses SQL Server
                        for application records and
                        ASP.NET Core Identity for
                        account authentication.
                    </p>

                    <p>
                        Passwords are processed using
                        Identity's password hashing
                        functionality rather than
                        being stored as plain-text
                        passwords.
                    </p>

                    <p class="mb-0">
                        Access controls and authentication
                        mechanisms are used to help protect
                        information. No internet-connected
                        system can guarantee absolute security.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        5. Administrator Access
                    </h2>

                    <p>
                        Authorised administrators can manage
                        interview categories, questions,
                        registered user information and
                        platform reports.
                    </p>

                    <p class="mb-0">
                        Administrative access should be
                        limited to authorised personnel
                        and used only for legitimate
                        platform management and support
                        purposes. Access to individual
                        interview responses depends on
                        the permissions implemented
                        in the application.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        6. Cookies and Authentication
                    </h2>

                    <p>
                        The platform uses authentication
                        cookies to maintain signed-in
                        sessions and recognise
                        authenticated users.
                    </p>

                    <p class="mb-0">
                        These cookies support account
                        access and application security.
                        Disabling necessary cookies may
                        prevent certain authenticated
                        features from functioning.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        7. Your Privacy Rights
                    </h2>

                    <p>
                        Subject to applicable law,
                        users may have rights to:
                    </p>

                    <ul class="mb-0">
                        <li>Request access to personal information</li>
                        <li>Request correction of inaccurate information</li>
                        <li>Request deletion where legally applicable</li>
                        <li>Object to certain processing activities</li>
                        <li>Raise concerns about personal information handling</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">
                        8. Data Retention
                    </h2>

                    <p>
                        Account details and interview
                        activity may be retained to
                        support continued use of the
                        platform, subject to applicable
                        legal requirements.
                    </p>

                    <p class="mb-0">
                        Specific retention periods,
                        account deletion procedures
                        and backup retention arrangements
                        must be confirmed before
                        production deployment.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Contact and Updates -->
    <section class="card shadow-sm rounded-4 mt-4">
        <div class="card-body p-4 p-md-5">

            <h2 class="h4 fw-bold">
                9. Privacy Enquiries
            </h2>

            <p>
                If you have questions about this Privacy
                Policy or wish to exercise your privacy
                rights, please contact the designated
                Tsebe CareerPrep privacy representative.
            </p>

            <p class="text-muted small">
                Privacy contact details will be published
                once confirmed by the platform owner.
            </p>

            <hr class="my-4" />

            <h2 class="h4 fw-bold">
                10. Changes to This Policy
            </h2>

            <p class="mb-0">
                This policy may be updated when the
                platform's functionality, information
                handling practices or applicable
                legal requirements change.
                Material updates should be communicated
                through the platform as appropriate.
            </p>

        </div>
    </section>

    <p class="text-muted small mt-4 text-center">
        Tsebe CareerPrep | Privacy Policy
    </p>

</div>

