@model List<TsebeCareerPrep.Mvc.Services.InterviewCategoryDto>

@{
    ViewData["Title"] = "Interview Categories";
}

<section class="interview-categories-page">

    <!-- Page introduction -->

    <div class="category-page-header">

        <div class="category-page-header-content">

            <p class="category-eyebrow">
                INTERVIEW PREPARATION
            </p>

            <h1>
                Choose Your Interview Category
            </h1>

            <p>
                Explore interview topics, practise answering
                questions and build confidence for your next
                career opportunity.
            </p>

        </div>

    </div>


    <!-- Categories content -->

    <div class="category-page-content">

        <div class="category-section-heading">

            <h2>Available Categories</h2>

            <p>
                Select a category to begin your preparation.
            </p>

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info"
                 role="status">

                No interview categories are currently available.

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var category in Model)
                {
                    <div class="col-12 col-md-6">

                        <article class="category-card h-100">

                            <div class="category-card-top">

                                <div class="category-card-icon"
                                     aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <rect x="3" y="7"
                                              width="18" height="14"
                                              rx="2" />
                                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <path d="M3 13h18" />
                                    </svg>
                                </div>

                                <span class="category-status">
                                    Available
                                </span>

                            </div>

                            <h3 class="category-card-title">
                                @category.Name
                            </h3>

                            <p class="category-card-description">
                                @category.Description
                            </p>

                            <div class="category-card-actions">

                                <form asp-controller="InterviewSessions"
                                      asp-action="Start"
                                      method="post"
                                      class="category-start-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="categoryId"
                                           value="@category.Id" />

                                    <button type="submit"
                                            class="btn btn-primary category-primary-button">

                                        Start Interview

                                    </button>

                                </form>

                                <a asp-controller="InterviewQuestions"
                                   asp-action="Category"
                                   asp-route-id="@category.Id"
                                   class="btn btn-outline-primary category-secondary-button">

                                    Practise Questions

                                </a>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </div>

</section>
