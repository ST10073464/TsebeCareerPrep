@model TsebeCareerPrep.Mvc.Models.AdminReportOverviewViewModel

@{
    ViewData["Title"] = "Administrator Reports";

    var otherSessions = Math.Max(
        0,
        Model.TotalSessions
        - Model.CompletedSessions
        - Model.InProgressSessions);

    var completionWidth = Math.Clamp(
        Model.CompletionRate, 0, 100);

    var completionPercentage = completionWidth.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    /* Administrator Reports */
    .admin-reports-page {
        color: #09234a;
    }

        .admin-reports-page .report-heading {
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .admin-reports-page .report-card {
            border: 1px solid #e1e5eb;
            border-radius: 6px;
            height: 100%;
        }

            .admin-reports-page .report-card .card-body {
                padding: 1.5rem;
            }

        .admin-reports-page .report-label {
            color: #66758b;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .admin-reports-page .report-value {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 0;
            overflow-wrap: anywhere;
        }

        .admin-reports-page .report-section {
            border: 1px solid #e1e5eb;
            border-radius: 6px;
        }

        .admin-reports-page .report-section-title {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .admin-reports-page .report-progress {
            height: 18px;
            border-radius: 6px;
        }

        .admin-reports-page .report-table {
            width: 100%;
        }

            .admin-reports-page .report-table th,
            .admin-reports-page .report-table td {
                padding: 0.85rem;
                vertical-align: middle;
            }

            .admin-reports-page .report-table .badge {
                font-size: 0.8rem;
            }

    @@media (max-width: 767.98px) {
        .admin-reports-page {
            padding-top: 2rem !important;
            padding-bottom: 5rem !important;
        }

            .admin-reports-page .report-heading {
                font-size: 1.55rem;
                line-height: 1.25;
            }

            .admin-reports-page .report-back-button {
                width: fit-content;
            }

            .admin-reports-page .report-card .card-body {
                padding: 1rem 1.1rem;
            }

            .admin-reports-page .report-label {
                font-size: 0.85rem;
                margin-bottom: 0.4rem;
            }

            .admin-reports-page .report-value {
                font-size: 1.7rem;
            }

            .admin-reports-page .report-section .card-body {
                padding: 1.1rem;
            }

            .admin-reports-page .report-section-title {
                font-size: 1.1rem;
            }

            .admin-reports-page .completion-summary {
                font-size: 0.85rem;
            }

            .admin-reports-page .report-table {
                font-size: 0.85rem;
            }

                .admin-reports-page .report-table th,
                .admin-reports-page .report-table td {
                    padding: 0.7rem 0.5rem;
                }

                .admin-reports-page .report-table .badge {
                    font-size: 0.7rem;
                    white-space: normal;
                    text-align: left;
                }
    }
</style>

<div class="container py-5 admin-reports-page">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between
        align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h1 class="report-heading">
                Administrator Reports
            </h1>

            <p class="text-muted mb-0">
                Platform-wide interview activity and
                performance statistics.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary report-back-button">
            Back to Dashboard
        </a>

    </div>

    <!-- OVERVIEW CARDS -->
    <div class="row g-3 g-md-4 mb-4">

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        Registered Users
                    </p>

                    <h2 class="report-value">
                        @Model.TotalUsers
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        Total Interview Sessions
                    </p>

                    <h2 class="report-value">
                        @Model.TotalSessions
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        Completed Interviews
                    </p>

                    <h2 class="report-value">
                        @Model.CompletedSessions
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        In-Progress Interviews
                    </p>

                    <h2 class="report-value">
                        @Model.InProgressSessions
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        Active Interview Categories
                    </p>

                    <h2 class="report-value">
                        @Model.ActiveCategories
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm report-card">
                <div class="card-body">
                    <p class="report-label">
                        Submitted Answers
                    </p>

                    <h2 class="report-value">
                        @Model.TotalAnswers
                    </h2>
                </div>
            </div>
        </div>

    </div>

    @if (User.IsInRole("SuperAdministrator"))
    {
        <div class="card shadow-sm report-section mb-4">
            <div class="card-body p-4">
                <h4 class="report-section-title mb-3">Administrator Account History</h4>
                <p class="text-muted">Recorded administrator changes since tracking began.</p>
                <div class="row g-3">
                    <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="report-label">Promotions</div><div class="report-value">@Model.PromotedAdministrators</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="report-label">Demotions</div><div class="report-value">@Model.DemotedAdministrators</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="report-label">Deleted accounts</div><div class="report-value">@Model.DeletedAdministrators</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="report-label">Restored accounts</div><div class="report-value">@Model.RestoredAccounts</div></div></div>
                </div>
                <h5 class="fw-bold mt-4">Recent actions</h5>
                @if (Model.RecentUserAdminActions.Count == 0)
                {
                    <p class="text-muted mb-0">No administrator changes have been recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead><tr><th>Action</th><th>Account</th><th>Performed by</th><th>Date</th></tr></thead>
                            <tbody>
                                @foreach (var action in Model.RecentUserAdminActions)
                                {
                                    <tr>
                                        <td>@action.Action</td>
                                        <td class="text-break">@action.TargetEmail</td>
                                        <td class="text-break">@(action.PerformedBy ?? "System")</td>
                                        <td>@action.OccurredUtc.ToLocalTime().ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- INTERVIEW COMPLETION RATE -->
    <div class="card shadow-sm report-section mb-4">

        <div class="card-body p-4">

            <h4 class="report-section-title mb-3">
                Interview Completion Rate
            </h4>

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2 mb-2">

                <span class="text-muted completion-summary">
                    Completed interview sessions
                </span>

                <strong>
                    @Model.CompletionRate.ToString("0.#")%
                </strong>

            </div>

            <div class="progress report-progress"
                 role="progressbar"
                 aria-label="Interview completion rate"
                 aria-valuenow="@completionPercentage"
                 aria-valuemin="0"
                 aria-valuemax="100">

                <div class="progress-bar bg-success"
                     style="width: @(completionPercentage)%;">
                </div>

            </div>

            <p class="text-muted mt-3 mb-0 completion-summary">
                @Model.CompletedSessions of
                @Model.TotalSessions interview sessions completed.
            </p>

        </div>

    </div>

    <!-- SESSION BREAKDOWN -->
    <div class="card shadow-sm report-section">

        <div class="card-body p-4">

            <h4 class="report-section-title mb-3">
                Interview Session Breakdown
            </h4>

            <div class="table-responsive">

                <table class="table table-bordered
                    align-middle mb-0 report-table">

                    <thead class="table-light">
                        <tr>
                            <th scope="col">
                                Session Status
                            </th>

                            <th scope="col" class="text-end">
                                Number of Sessions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            </td>

                            <td class="text-end">
                                @Model.CompletedSessions
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span class="badge bg-primary">
                                    In Progress
                                </span>
                            </td>

                            <td class="text-end">
                                @Model.InProgressSessions
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span class="badge bg-secondary">
                                    Other Statuses
                                </span>
                            </td>

                            <td class="text-end">
                                @otherSessions
                            </td>
                        </tr>

                    </tbody>

                    <tfoot class="table-light">
                        <tr>
                            <th scope="row">
                                Total Sessions
                            </th>

                            <th class="text-end">
                                @Model.TotalSessions
                            </th>
                        </tr>
                    </tfoot>

                </table>

            </div>

        </div>

    </div>

</div>
