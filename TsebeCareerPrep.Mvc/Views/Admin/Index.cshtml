@{
    ViewData["Title"] = "Administrator Dashboard";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Administrator Dashboard</h1>

        <p class="text-muted">
            Manage interview preparation content
            and platform administration.
        </p>
    </div>

    <div class="row g-4">

        <!-- Interview Questions Management -->
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="fw-bold">
                        Interview Questions
                    </h4>

                    <p class="text-muted">
                        Create, edit, activate and deactivate
                        interview questions.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="AdminQuestions"
                           asp-action="Index"
                           class="btn btn-primary">
                            Manage Questions
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Interview Categories Management -->
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="fw-bold">
                        Interview Categories
                    </h4>

                    <p class="text-muted">
                        Create, edit, activate and deactivate
                        interview categories.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="AdminCategories"
                           asp-action="Index"
                           class="btn btn-primary">
                            Manage Categories
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Administrator Reporting -->
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="fw-bold">
                        Administrator Reports
                    </h4>

                    <p class="text-muted">
                        View registered users, interview activity,
                        completion rates and platform statistics.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="AdminReports"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Reports
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Administrator User Management -->
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="fw-bold">
                        User Management
                    </h4>

                    <p class="text-muted">
                        View registered users, assigned roles
                        and account lockout status.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="AdminUsers"
                           asp-action="Index"
                           class="btn btn-primary">
                            Manage Users
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>
