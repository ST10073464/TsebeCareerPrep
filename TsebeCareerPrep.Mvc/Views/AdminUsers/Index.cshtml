@model List<TsebeCareerPrep.Mvc.Models.AdminUserViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Users</h1>

            <p class="text-muted mb-0">
                View registered users, assigned roles and account status.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Registered Users</h4>

                <span class="badge bg-primary">
                    @(Model?.Count ?? 0) Users
                </span>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No registered users are available.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Email</td>
                                    <td>@user.UserName</td>

                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-primary me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Standard User
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">
                                                Locked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Not Locked
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="Unlock"
                                                  asp-route-id="@user.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary"
                                                        onclick="return confirm('Are you sure you want to unlock this user account?');">
                                                    Unlock
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
