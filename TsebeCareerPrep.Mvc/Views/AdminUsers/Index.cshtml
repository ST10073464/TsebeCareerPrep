@model List<TsebeCareerPrep.Mvc.Models.AdminUserViewModel>

@{
    ViewData["Title"] = "Manage Users";

    string? highlightedUserId =
        TempData["HighlightUserId"]?.ToString();

    string highlightType =
        TempData["HighlightType"]?.ToString() ?? "status";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between
        align-items-start align-items-md-center
        flex-column flex-md-row gap-3 mb-4">

        <div>
            <h1 class="fw-bold">Manage Users</h1>

            <p class="text-muted mb-0">
                View registered users, assigned roles
                and account status.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- REGISTERED USERS -->
    <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">

            <div class="d-flex justify-content-between
                align-items-center gap-2 mb-3">

                <h4 class="fw-bold mb-0">
                    Registered Users
                </h4>

                <span class="badge bg-primary">
                    @(Model?.Count ?? 0) Users
                </span>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No registered users are available.
                </div>
            }
            else
            {
                <!-- DESKTOP TABLE -->
                <div class="table-responsive d-none d-xl-block">

                    <table class="table table-bordered
                        table-striped align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                var isAdministrator = user.Roles?.Contains("Administrator") ?? false;
                                <tr data-highlight-target="user-@user.Id"
                                    data-highlight-on-load="@(highlightedUserId == user.Id ? "true" : "false")"
                                    data-highlight-type="@highlightType">

                                    <td class="text-break">
                                        @user.Email
                                    </td>

                                    <td class="text-break">
                                        @user.UserName
                                    </td>

                                    <td>
                                        @if (user.Roles != null &&
                                             user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-primary me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Standard User
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsDeactivated)
                                        {
                                            <span class="badge bg-secondary">Deleted · ID preserved</span>
                                        }
                                        else if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">
                                                Locked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Not Locked
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!user.IsDeactivated && User.IsInRole("SuperAdministrator") && isAdministrator &&
                                             !(user.Roles?.Contains("SuperAdministrator") ?? false))
                                        {
                                            <form asp-controller="AdminUsers" asp-action="Demote" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning mb-1"
                                                        onclick="return confirm('Remove Administrator access? This user will become a candidate.');">Demote</button>
                                            </form>
                                            <form asp-controller="AdminUsers" asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger mb-1"
                                                        onclick="return confirm('Deactivate this administrator? Their account ID and history will be retained.');">Delete</button>
                                            </form>
                                        }
                                        else if (!user.IsDeactivated && User.IsInRole("SuperAdministrator") && !isAdministrator &&
                                                 !(user.Roles?.Contains("SuperAdministrator") ?? false))
                                        {
                                            <form asp-controller="AdminUsers" asp-action="Promote"
                                                  asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-primary mb-1"
                                                        onclick="return confirm('Grant this user Administrator access?');">Make Administrator</button>
                                            </form>
                                        }
                                        @if (!user.IsDeactivated && user.IsLockedOut)
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="Unlock"
                                                  asp-route-id="@user.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary"
                                                        onclick="return confirm('Are you sure you want to unlock this user account?');">
                                                    Unlock
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- MOBILE USER CARDS -->
                <div class="row g-3 d-xl-none">

                    @foreach (var user in Model)
                    {
                        var isAdministrator = user.Roles?.Contains("Administrator") ?? false;
                        <div class="col-12 col-md-6">
                        <div class="card shadow-sm h-100"
                             data-highlight-target="user-@user.Id"
                             data-highlight-on-load="@(highlightedUserId == user.Id ? "true" : "false")"
                             data-highlight-type="@highlightType">
                            <div class="card-body p-3">

                                <!-- USER HEADER -->
                                <div class="d-flex justify-content-between
                                    align-items-start gap-2 mb-3">

                                    <span class="badge @(user.IsDeactivated ? "bg-secondary" : "bg-primary")">
                                        @(user.IsDeactivated ? "Deleted account" : "User account")
                                    </span>

                                    @if (user.IsDeactivated)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else if (user.IsLockedOut)
                                    {
                                        <span class="badge bg-danger">
                                            Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Not Locked
                                        </span>
                                    }
                                </div>

                                <!-- EMAIL -->
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">
                                        Email Address
                                    </div>

                                    <div class="fw-semibold text-break">
                                        @user.Email
                                    </div>
                                </div>

                                <!-- USERNAME -->
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">
                                        Username
                                    </div>

                                    <div class="text-break">
                                        @user.UserName
                                    </div>
                                </div>

                                <!-- ASSIGNED ROLES -->
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">
                                        Assigned Role
                                    </div>

                                    @if (user.Roles != null &&
                                         user.Roles.Any())
                                    {
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-primary me-1">
                                                @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Standard User
                                        </span>
                                    }
                                </div>

                                <!-- ACCOUNT ACTIONS -->
                                @if (user.IsDeactivated)
                                {
                                    <div class="alert alert-secondary py-2 mb-2">Deleted · ID and history preserved</div>
                                }
                                else if (User.IsInRole("SuperAdministrator") && isAdministrator &&
                                         !(user.Roles?.Contains("SuperAdministrator") ?? false))
                                {
                                    <div class="d-grid gap-2 mb-2">
                                        <form asp-controller="AdminUsers" asp-action="Demote" asp-route-id="@user.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning w-100"
                                                    onclick="return confirm('Remove Administrator access? This user will become a candidate.');">Demote to Candidate</button>
                                        </form>
                                        <form asp-controller="AdminUsers" asp-action="Deactivate" asp-route-id="@user.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger w-100"
                                                    onclick="return confirm('Deactivate this administrator? Their account ID and history will be retained.');">Delete Administrator</button>
                                        </form>
                                    </div>
                                }
                                else if (User.IsInRole("SuperAdministrator") && !isAdministrator &&
                                         !(user.Roles?.Contains("SuperAdministrator") ?? false))
                                {
                                    <form asp-controller="AdminUsers" asp-action="Promote"
                                          asp-route-id="@user.Id" method="post" class="mb-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-primary w-100"
                                                onclick="return confirm('Grant this user Administrator access?');">
                                            Make Administrator
                                        </button>
                                    </form>
                                }

                                @if (!user.IsDeactivated && user.IsLockedOut)
                                {
                                    <form asp-controller="AdminUsers"
                                          asp-action="Unlock"
                                          asp-route-id="@user.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-primary w-100"
                                                onclick="return confirm('Are you sure you want to unlock this user account?');">
                                            Unlock Account
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="small text-muted">
                                        No account action required.
                                    </div>
                                }

                            </div>
                        </div>
                        </div>
                    }

                </div>
            }

        </div>
    </div>

</div>
