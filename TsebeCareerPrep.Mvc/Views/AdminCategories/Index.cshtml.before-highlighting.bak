@model List<TsebeCareerPrep.Mvc.Models.InterviewCategoryAdminViewModel>

@{
    ViewData["Title"] = "Manage Interview Categories";

    var categories = Model?.ToList()
        ?? new List<TsebeCareerPrep.Mvc.Models.InterviewCategoryAdminViewModel>();

    var totalQuestions = categories.Sum(c => c.TotalQuestions);
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between
        align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold">
                Manage Interview Categories
            </h1>

            <p class="text-muted mb-0">
                View categories and manage the interview question bank.
            </p>
        </div>

        <a asp-controller="AdminCategories"
           asp-action="Create"
           class="btn btn-primary">
            + Create Category
        </a>
    </div>

    <!-- SUCCESS NOTIFICATION -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- CATEGORY MANAGEMENT -->
    <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2 mb-4">

                <div>
                    <h4 class="fw-bold mb-2">
                        Category Bank
                    </h4>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary">
                            @categories.Count Categories
                        </span>

                        <span class="badge bg-secondary">
                            @totalQuestions Questions
                        </span>
                    </div>
                </div>
            </div>

            @if (categories.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No interview categories are available.
                </div>
            }
            else
            {
                <!-- DESKTOP / TABLET TABLE -->
                <div class="d-none d-lg-block">

                    <div class="table-responsive">
                        <table class="table table-bordered
                            table-striped align-middle">

                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <th>Questions</th>
                                    <th>Difficulty Breakdown</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var category in categories)
                                {
                                    <tr>
                                        <td>@category.Id</td>

                                        <td class="fw-semibold">
                                            @category.Name
                                        </td>

                                        <td class="category-description">
                                            @category.Description
                                        </td>

                                        <td>
                                            <span class="badge bg-primary fs-6">
                                                @category.TotalQuestions
                                            </span>
                                        </td>

                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="small">
                                                    Beginner:
                                                    <strong>
                                                        @category.BeginnerQuestions
                                                    </strong>
                                                </span>

                                                <span class="small">
                                                    Intermediate:
                                                    <strong>
                                                        @category.IntermediateQuestions
                                                    </strong>
                                                </span>

                                                <span class="small">
                                                    Advanced:
                                                    <strong>
                                                        @category.AdvancedQuestions
                                                    </strong>
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            @if (category.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a asp-controller="AdminQuestions"
                                                   asp-action="ByCategory"
                                                   asp-route-id="@category.Id"
                                                   class="btn btn-sm btn-primary">
                                                    View Questions
                                                </a>

                                                <a asp-controller="AdminCategories"
                                                   asp-action="Edit"
                                                   asp-route-id="@category.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Edit Category
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- MOBILE CATEGORY CARDS -->
                <div class="d-lg-none">
                    <div class="row g-3">

                        @foreach (var category in categories)
                        {
                            <div class="col-12">
                                <div class="card shadow-sm h-100">

                                    <div class="card-body p-3">

                                        <!-- CATEGORY HEADER -->
                                        <div class="d-flex justify-content-between
                                            align-items-start gap-2 mb-3">

                                            <span class="badge bg-primary">
                                                Category #@category.Id
                                            </span>

                                            @if (category.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Inactive
                                                </span>
                                            }
                                        </div>

                                        <!-- CATEGORY NAME -->
                                        <h5 class="fw-bold mb-3">
                                            @category.Name
                                        </h5>

                                        <!-- CATEGORY DESCRIPTION -->
                                        <div class="mb-3">
                                            <div class="small fw-semibold
                                                text-muted mb-1">
                                                Description
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                category.Description))
                                            {
                                                <p class="text-muted mb-0">
                                                    @category.Description
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="text-muted fst-italic mb-0">
                                                    No description available.
                                                </p>
                                            }
                                        </div>

                                        <!-- QUESTION STATISTICS -->
                                        <div class="category-stats mb-3">

                                            <div class="d-flex justify-content-between
                                                align-items-center mb-3">

                                                <span class="fw-semibold">
                                                    Question Statistics
                                                </span>

                                                <span class="badge bg-primary">
                                                    @category.TotalQuestions Total
                                                </span>
                                            </div>

                                            <div class="row g-2">

                                                <div class="col-4">
                                                    <div class="stat-box">
                                                        <div class="stat-value">
                                                            @category.BeginnerQuestions
                                                        </div>
                                                        <div class="stat-label">
                                                            Beginner
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-4">
                                                    <div class="stat-box">
                                                        <div class="stat-value">
                                                            @category.IntermediateQuestions
                                                        </div>
                                                        <div class="stat-label">
                                                            Intermediate
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-4">
                                                    <div class="stat-box">
                                                        <div class="stat-value">
                                                            @category.AdvancedQuestions
                                                        </div>
                                                        <div class="stat-label">
                                                            Advanced
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                        <!-- CATEGORY ACTIONS -->
                                        <div class="d-grid gap-2">
                                            <a asp-controller="AdminQuestions"
                                               asp-action="ByCategory"
                                               asp-route-id="@category.Id"
                                               class="btn btn-primary">
                                                View Questions
                                            </a>

                                            <a asp-controller="AdminCategories"
                                               asp-action="Edit"
                                               asp-route-id="@category.Id"
                                               class="btn btn-outline-primary">
                                                Edit Category
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </div>

    <!-- BACK TO ADMIN DASHBOARD -->
    <div class="mt-4">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Administrator Dashboard
        </a>
    </div>

</div>

<style>
    .category-description {
        min-width: 180px;
        overflow-wrap: anywhere;
    }

    .category-stats {
        background: var(--bs-tertiary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 10px;
        padding: 14px;
    }

    .stat-box {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 8px;
        padding: 12px 4px;
        text-align: center;
        height: 100%;
    }

    .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .stat-label {
        font-size: 0.72rem;
        color: var(--bs-secondary-color, #6c757d);
        overflow-wrap: anywhere;
    }

    .card-body h5,
    .card-body p {
        overflow-wrap: anywhere;
    }

    @@media (max-width: 991.98px) {
        .card-body h5 {
            font-size: 1.05rem;
            line-height: 1.5;
        }

        .card-body .badge {
            white-space: normal;
            text-align: left;
        }

        .card-body .btn {
            max-width: 100%;
        }
    }

    @@media (max-width: 360px) {
        .stat-value {
            font-size: 1.15rem;
        }

        .stat-label {
            font-size: 0.65rem;
        }

        .category-stats {
            padding: 10px;
        }
    }
</style>
