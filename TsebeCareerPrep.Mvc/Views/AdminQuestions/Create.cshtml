@model TsebeCareerPrep.Mvc.Models.CreateInterviewQuestionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Interview Question";

    var categoryFromPage = Context.Request.Query.ContainsKey("categoryId");
    // Only reset a fresh, unscoped GET. Preserve selections on failed POST validation.
    var resetCategoryOnFreshGet = HttpMethods.IsGet(Context.Request.Method)
        && !categoryFromPage;

    var categories =
        ViewBag.Categories as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

<style>
    /* ==========================================
                   CREATE INTERVIEW QUESTION
                   ========================================== */

    .create-question-page {
        color: #09234a;
        max-width: 960px;
        margin-left: auto;
        margin-right: auto;
        min-width: 0;
    }

        .create-question-page .page-title {
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .create-question-page .question-form-card {
            border: 1px solid #e1e5eb;
            border-radius: 8px;
            min-width: 0;
        }

        .create-question-page .card-body,
        .create-question-page form {
            min-width: 0;
        }

        .create-question-page .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .create-question-page .form-control {
            display: block;
            width: 100%;
            max-width: 100%;
            min-width: 0;
            box-sizing: border-box;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 0.7rem 0.85rem;
            font-size: 1rem;
        }

        .create-question-page textarea {
            resize: vertical;
        }

        .create-question-page .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
        }

        .create-question-page .field-help {
            font-size: 0.85rem;
            color: #66758b;
            margin-top: 0.4rem;
        }

        /* ==========================================
                   CUSTOM DROPDOWNS
                   ========================================== */

        .create-question-page .custom-dropdown {
            position: relative;
            width: 100%;
            min-width: 0;
        }

        .create-question-page .custom-dropdown-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            width: 100%;
            min-height: 48px;
            padding: 0.7rem 0.85rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: #fff;
            color: #09234a;
            text-align: left;
            font-size: 1rem;
            line-height: 1.5;
            cursor: pointer;
        }

            .create-question-page .custom-dropdown-trigger:focus-visible,
            .create-question-page .custom-dropdown-trigger[aria-expanded="true"] {
                outline: none;
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
            }

        .create-question-page .custom-dropdown-text {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .create-question-page .custom-dropdown-arrow {
            flex-shrink: 0;
            width: 9px;
            height: 9px;
            border-right: 2px solid #64748b;
            border-bottom: 2px solid #64748b;
            transform: rotate(45deg);
            transition: transform 0.15s ease;
            margin-right: 4px;
            margin-top: -4px;
        }

        .create-question-page .custom-dropdown-trigger[aria-expanded="true"]
        .custom-dropdown-arrow {
            transform: rotate(225deg);
            margin-top: 4px;
        }

        .create-question-page .custom-dropdown-menu {
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            right: 0;
            z-index: 1050;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: 5px;
            background: #fff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            box-shadow: 0 8px 24px rgba(15,23,42,.12);
        }

            .create-question-page .custom-dropdown-menu[hidden] {
                display: none !important;
            }

        .create-question-page .custom-dropdown-option {
            display: block;
            width: 100%;
            padding: 11px 12px;
            border: none;
            border-radius: 4px;
            background: transparent;
            color: #09234a;
            text-align: left;
            font-size: 0.95rem;
            cursor: pointer;
            overflow-wrap: anywhere;
        }

            .create-question-page .custom-dropdown-option:hover,
            .create-question-page .custom-dropdown-option:focus-visible {
                background: #eaf2ff;
                outline: none;
            }

            .create-question-page .custom-dropdown-option[aria-selected="true"] {
                background: #dbeafe;
                color: #084298;
                font-weight: 600;
            }

        /*
                   Native selects remain available for model binding,
                   validation and non-JavaScript fallback.
                */

        .create-question-page .native-select {
            display: block;
            width: 100%;
            min-height: 48px;
            padding: 0.7rem 0.85rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: #fff;
            color: #09234a;
            font-size: 1rem;
        }

            .create-question-page .native-select[hidden] {
                display: none !important;
            }

        .create-question-page .form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

            .create-question-page .form-actions .btn {
                min-height: 44px;
            }

    @@media (max-width: 767.98px) {

        .create-question-page {
            width: 100%;
            max-width: 100%;
            padding-top: 2rem !important;
            padding-bottom: 5rem !important;
        }

            .create-question-page .page-title {
                font-size: 1.55rem;
                line-height: 1.3;
            }

            .create-question-page .question-form-card {
                width: 100%;
                max-width: 100%;
            }

                .create-question-page .question-form-card .card-body {
                    padding: 1.1rem !important;
                }

            .create-question-page .form-control,
            .create-question-page .custom-dropdown-trigger,
            .create-question-page .native-select {
                font-size: 16px;
                min-height: 48px;
            }

            .create-question-page textarea {
                min-height: 110px;
            }

            .create-question-page .custom-dropdown-menu {
                max-height: 220px;
            }

            .create-question-page .form-actions {
                flex-direction: column;
            }

                .create-question-page .form-actions .btn {
                    width: 100%;
                }

            .create-question-page .back-button {
                width: fit-content;
                max-width: 100%;
            }
    }

    /* Category confirmation flow: works with the existing custom dropdown. */
    .create-question-page .locked-category {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: .8rem .9rem;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

        .create-question-page .locked-category[hidden],
        .create-question-page #question-details[hidden] {
            display: none !important;
        }
</style>

<div class="container py-5 create-question-page">

    <!-- PAGE HEADER -->
    <div class="mb-4">

        <a asp-controller="AdminQuestions"
           asp-action="Index"
           class="btn btn-outline-secondary mb-3 back-button">
            Back to Question Bank
        </a>

        <h1 class="page-title">
            Create Interview Question
        </h1>

        <p class="text-muted mb-0">
            Add a new question to the interview question bank.
        </p>

    </div>

    <!-- CREATE QUESTION FORM -->
    <div class="card shadow-sm question-form-card">

        <div class="card-body p-4">

            <form asp-controller="AdminQuestions"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- INTERVIEW CATEGORY -->
                <div class="mb-4">

                    <label asp-for="InterviewCategoryId"
                           class="form-label">
                    </label>

                    <div class="custom-dropdown"
                         data-custom-dropdown>

                        <!-- Native field for model binding -->
                        <select asp-for="InterviewCategoryId"
                                asp-items="categories"
                                class="native-select"
                                data-native-select>
                            <option value="">
                                -- Select Category --
                            </option>
                        </select>

                        <!-- Custom trigger -->
                        <button type="button"
                                class="custom-dropdown-trigger"
                                data-dropdown-trigger
                                aria-haspopup="listbox"
                                aria-expanded="false"
                                aria-controls="category-options"
                                hidden>

                            <span class="custom-dropdown-text"
                                  data-dropdown-text>
                                -- Select Category --
                            </span>

                            <span class="custom-dropdown-arrow"
                                  aria-hidden="true">
                            </span>

                        </button>

                        <!-- Custom options -->
                        <div class="custom-dropdown-menu"
                             id="category-options"
                             role="listbox"
                             aria-label="Interview Category"
                             data-dropdown-menu
                             hidden>

                            <button type="button"
                                    class="custom-dropdown-option"
                                    role="option"
                                    data-value=""
                                    aria-selected="false">
                                -- Select Category --
                            </button>

                            @foreach (var category in categories)
                            {
                                <button type="button"
                                        class="custom-dropdown-option"
                                        role="option"
                                        data-value="@category.Value"
                                        aria-selected="false">
                                    @category.Text
                                </button>
                            }

                        </div>

                    </div>

                    <span asp-validation-for="InterviewCategoryId"
                          class="text-danger small">
                    </span>

                    <!-- Read-only category display, shown after confirmation -->
                    <div id="locked-category" class="locked-category" hidden>
                        <div class="locked-category-name" id="locked-category-name"></div>
                        <span aria-hidden="true">&#128274;</span>
                    </div>

                    <div id="category-select-actions" class="mt-3" hidden>
                        <button type="button" id="confirm-category" class="btn btn-primary">
                            Confirm Category
                        </button>
                    </div>

                    <div id="category-locked-actions" class="mt-2" hidden>
                        <span class="small text-muted d-block mb-2">
                            Category locked for this question.
                        </span>
                        <button type="button" id="change-category" class="btn btn-sm btn-outline-secondary">
                            Change Category
                        </button>
                    </div>
                </div>

                <div id="question-details">
                    <!-- QUESTION TEXT -->
                    <div class="mb-4">

                        <label asp-for="QuestionText"
                               class="form-label">
                        </label>

                        <textarea asp-for="QuestionText"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Enter the interview question"></textarea>

                        <div class="field-help">
                            Enter a clear interview question.
                            Maximum 1,000 characters.
                        </div>

                        <span asp-validation-for="QuestionText"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- SUGGESTED ANSWER -->
                    <div class="mb-4">

                        <label asp-for="SuggestedAnswer"
                               class="form-label">
                        </label>

                        <textarea asp-for="SuggestedAnswer"
                                  class="form-control"
                                  rows="5"
                                  maxlength="2000"
                                  placeholder="Enter a suggested answer"></textarea>

                        <div class="field-help">
                            Provide a suggested answer for interview preparation.
                            Maximum 2,000 characters.
                        </div>

                        <span asp-validation-for="SuggestedAnswer"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- DIFFICULTY LEVEL -->
                    <div class="mb-4">

                        <label asp-for="DifficultyLevel"
                               class="form-label">
                        </label>

                        <div class="custom-dropdown"
                             data-custom-dropdown>

                            <!-- Native field for model binding -->
                            <select asp-for="DifficultyLevel"
                                    class="native-select"
                                    data-native-select>

                                <option value="Beginner">
                                    Beginner
                                </option>

                                <option value="Intermediate">
                                    Intermediate
                                </option>

                                <option value="Advanced">
                                    Advanced
                                </option>

                            </select>

                            <!-- Custom trigger -->
                            <button type="button"
                                    class="custom-dropdown-trigger"
                                    data-dropdown-trigger
                                    aria-haspopup="listbox"
                                    aria-expanded="false"
                                    aria-controls="difficulty-options"
                                    hidden>

                                <span class="custom-dropdown-text"
                                      data-dropdown-text>
                                    Beginner
                                </span>

                                <span class="custom-dropdown-arrow"
                                      aria-hidden="true">
                                </span>

                            </button>

                            <!-- Custom options -->
                            <div class="custom-dropdown-menu"
                                 id="difficulty-options"
                                 role="listbox"
                                 aria-label="Difficulty Level"
                                 data-dropdown-menu
                                 hidden>

                                <button type="button"
                                        class="custom-dropdown-option"
                                        role="option"
                                        data-value="Beginner"
                                        aria-selected="false">
                                    Beginner
                                </button>

                                <button type="button"
                                        class="custom-dropdown-option"
                                        role="option"
                                        data-value="Intermediate"
                                        aria-selected="false">
                                    Intermediate
                                </button>

                                <button type="button"
                                        class="custom-dropdown-option"
                                        role="option"
                                        data-value="Advanced"
                                        aria-selected="false">
                                    Advanced
                                </button>

                            </div>

                        </div>

                        <span asp-validation-for="DifficultyLevel"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- ACTIVE STATUS -->
                    <div class="form-check mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                        </label>

                    </div>

                    <!-- FORM ACTIONS -->
                    <div class="form-actions">

                        <button type="submit"
                                class="btn btn-primary">
                            Create Question
                        </button>

                        <a asp-controller="AdminQuestions"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </div> <!-- /question-details -->
            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            "use strict";

            // A fresh Create page must not inherit a previously selected category.
            // Run this before custom dropdowns read the native select's value.
            const resetCategoryOnFreshGet = @(resetCategoryOnFreshGet ? "true" : "false");
            const initialCategorySelect = document.querySelector(
                'select[name="InterviewCategoryId"]');

            if (resetCategoryOnFreshGet && initialCategorySelect) {
                initialCategorySelect.value = '';
            }

            const dropdowns = Array.from(
                document.querySelectorAll(
                    ".create-question-page [data-custom-dropdown]"
                )
            );

            function closeDropdown(dropdown, restoreFocus = false) {
                const trigger = dropdown.querySelector(
                    "[data-dropdown-trigger]"
                );

                const menu = dropdown.querySelector(
                    "[data-dropdown-menu]"
                );

                menu.hidden = true;
                trigger.setAttribute("aria-expanded", "false");

                if (restoreFocus) {
                    trigger.focus();
                }
            }

            function closeAll(except = null) {
                dropdowns.forEach(dropdown => {
                    if (dropdown !== except) {
                        closeDropdown(dropdown);
                    }
                });
            }

            dropdowns.forEach(dropdown => {
                const nativeSelect = dropdown.querySelector(
                    "[data-native-select]"
                );

                const trigger = dropdown.querySelector(
                    "[data-dropdown-trigger]"
                );

                const triggerText = dropdown.querySelector(
                    "[data-dropdown-text]"
                );

                const menu = dropdown.querySelector(
                    "[data-dropdown-menu]"
                );

                const options = Array.from(
                    menu.querySelectorAll(
                        "[data-value]"
                    )
                );

                function syncSelection() {
                    const selectedOption =
                        nativeSelect.options[
                        nativeSelect.selectedIndex
                        ];

                    triggerText.textContent =
                        selectedOption
                            ? selectedOption.textContent.trim()
                            : "-- Select --";

                    options.forEach(option => {
                        option.setAttribute(
                            "aria-selected",
                            String(
                                option.dataset.value ===
                                nativeSelect.value
                            )
                        );
                    });
                }

                function openDropdown() {
                    closeAll(dropdown);

                    menu.hidden = false;
                    trigger.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    const selected = options.find(
                        option =>
                            option.dataset.value ===
                            nativeSelect.value
                    );

                    (selected || options[0])?.focus();
                }

                function selectOption(option) {
                    nativeSelect.value = option.dataset.value;

                    nativeSelect.dispatchEvent(
                        new Event("change", {
                            bubbles: true
                        })
                    );

                    syncSelection();
                    closeDropdown(dropdown, true);
                }

                // Enable custom interface only when
                // JavaScript is successfully initialized.
                syncSelection();
                nativeSelect.hidden = true;
                trigger.hidden = false;

                trigger.addEventListener("click", () => {
                    const isOpen =
                        trigger.getAttribute("aria-expanded") ===
                        "true";

                    if (isOpen) {
                        closeDropdown(dropdown);
                    } else {
                        openDropdown();
                    }
                });

                trigger.addEventListener("keydown", event => {
                    if (
                        event.key === "ArrowDown" ||
                        event.key === "ArrowUp" ||
                        event.key === "Enter" ||
                        event.key === " "
                    ) {
                        event.preventDefault();
                        openDropdown();
                    }
                });

                options.forEach((option, index) => {
                    option.addEventListener("click", () => {
                        selectOption(option);
                    });

                    option.addEventListener("keydown", event => {
                        if (event.key === "ArrowDown") {
                            event.preventDefault();

                            options[
                                (index + 1) % options.length
                            ].focus();
                        }

                        if (event.key === "ArrowUp") {
                            event.preventDefault();

                            options[
                                (index - 1 + options.length) %
                                options.length
                            ].focus();
                        }

                        if (event.key === "Home") {
                            event.preventDefault();
                            options[0].focus();
                        }

                        if (event.key === "End") {
                            event.preventDefault();
                            options[
                                options.length - 1
                            ].focus();
                        }

                        if (event.key === "Escape") {
                            event.preventDefault();
                            closeDropdown(dropdown, true);
                        }
                    });
                });

                nativeSelect.addEventListener(
                    "change",
                    syncSelection
                );
            });

            // Category selection must be confirmed before entering a question.
            // The underlying select remains enabled so its value is posted.
            const categorySelect = document.querySelector(
                'select[name="InterviewCategoryId"]');
            const categoryDropdown = categorySelect?.closest('[data-custom-dropdown]');
            const categoryTrigger = categoryDropdown?.querySelector('[data-dropdown-trigger]');
            const lockedDisplay = document.getElementById('locked-category');
            const lockedName = document.getElementById('locked-category-name');
            const selectActions = document.getElementById('category-select-actions');
            const lockedActions = document.getElementById('category-locked-actions');
            const confirmButton = document.getElementById('confirm-category');
            const changeButton = document.getElementById('change-category');
            const questionDetails = document.getElementById('question-details');
            const preselectedFromCategory = @(categoryFromPage ? "true" : "false");
            let categoryLocked = false;

            
            function updateCategoryUrl(categoryId) {
                const url = new URL(window.location.href);

                if (categoryId && categoryId !== "0") {
                    url.searchParams.set("categoryId", categoryId);
                } else {
                    url.searchParams.delete("categoryId");
                }

                window.history.replaceState(
                    null,
                    "",
                    url.pathname + url.search
                );
            }


            function updateCategoryUI() {
                if (!categorySelect || !categoryDropdown) return;
                const hasCategory = categorySelect.value !== '' &&
                    Array.from(categorySelect.options).some(o =>
                        o.value === categorySelect.value && !o.disabled);
                const selected = categorySelect.selectedOptions[0];
                categoryDropdown.hidden = categoryLocked;
                lockedDisplay.hidden = !categoryLocked;
                selectActions.hidden = categoryLocked;
                lockedActions.hidden = !categoryLocked;
                questionDetails.hidden = !categoryLocked;
                confirmButton.disabled = !hasCategory;
                if (categoryLocked) {
                    lockedName.textContent = selected?.textContent.trim() || '';
                }
            }

            if (categorySelect && categoryDropdown) {
                categorySelect.addEventListener('change', updateCategoryUI);
                confirmButton.addEventListener('click', () => {
                    if (!categorySelect.value) return;

                    categoryLocked = true;

                    updateCategoryUrl(categorySelect.value);

                    closeDropdown(categoryDropdown);
                    updateCategoryUI();

                    document.getElementById('QuestionText')?.focus();
                });

                
                changeButton.addEventListener('click', () => {
                    categoryLocked = false;

                    categorySelect.value = "";
                    categorySelect.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );

                    updateCategoryUrl(null);
                    updateCategoryUI();

                    categoryTrigger?.focus();
                });


                // Coming from a category locks immediately. After failed POST,
                // the user must confirm the preserved selection again.
                if (!preselectedFromCategory) {
                    categorySelect.value = "";
                    categorySelect.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );
                }

                categoryLocked =
                    preselectedFromCategory && !!categorySelect.value;

                updateCategoryUI();

            }

            // Browsers may restore form state when navigating Back/Forward.
            // Reset only the category on an unscoped GET; preserve other fields.
            window.addEventListener('pageshow', () => {
                if (!resetCategoryOnFreshGet || !categorySelect) return;
                categorySelect.value = '';
                categoryLocked = false;
                categorySelect.dispatchEvent(new Event('change', { bubbles: true }));
                updateCategoryUI();
            });

            document.addEventListener("click", event => {
                dropdowns.forEach(dropdown => {
                    if (!dropdown.contains(event.target)) {
                        closeDropdown(dropdown);
                    }
                });
            });

            document.addEventListener("keydown", event => {
                if (event.key === "Escape") {
                    dropdowns.forEach(dropdown => {
                        const trigger = dropdown.querySelector(
                            "[data-dropdown-trigger]"
                        );

                        if (
                            trigger.getAttribute("aria-expanded") ===
                            "true"
                        ) {
                            closeDropdown(dropdown, true);
                        }
                    });
                }
            });
        })();
    </script>
}
