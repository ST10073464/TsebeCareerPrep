@model TsebeCareerPrep.Mvc.Models.InterviewResultsViewModel

@{
    ViewData["Title"] = "Interview Results";

    var isCompleted = Model.Session.Status == "Completed";
    var totalQuestions = Model.TotalQuestions;
    var answeredQuestions = Model.TotalAnswered;
    var skippedQuestions = Model.TotalSkipped;
}

<section class="interview-results-page">

    <!-- =====================================
         RESULTS HEADER
         ===================================== -->
    <div class="interview-results-header">

        <a asp-controller="InterviewSessions"
           asp-action="Details"
           asp-route-id="@Model.Session.Id"
           class="interview-back-link">
            <span aria-hidden="true">&#8592;</span>
            Back to Interview Session
        </a>

        <p class="interview-results-eyebrow">
            INTERVIEW PRACTICE
        </p>

        <h1>Interview Results</h1>

        <p class="interview-results-introduction">
            Review your responses, compare them with
            suggested answers and identify opportunities
            to strengthen your interview skills.
        </p>

        <div class="interview-results-header-summary">
            <span class="interview-results-category">
                @Model.Session.CategoryName
            </span>

            <span class="interview-results-status
                @(isCompleted ? "completed" : "in-progress")">
                @Model.Session.Status
            </span>
        </div>
    </div>

    <!-- =====================================
         SESSION SUMMARY
         ===================================== -->
    <div class="interview-results-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">
                @TempData["Success"]
            </div>
        }

        <div class="interview-results-summary">

            <h2>Interview Summary</h2>

            <div class="row g-3">

                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Total Questions
                        </span>
                        <strong>@totalQuestions</strong>
                    </div>
                </div>


                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Questions Answered
                        </span>

                        <strong>
                            @answeredQuestions of @totalQuestions
                        </strong>
                    </div>
                </div>


                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Questions Skipped
                        </span>
                        <strong>@skippedQuestions</strong>
                    </div>
                </div>

                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Session ID
                        </span>
                        <strong>#@Model.Session.Id</strong>
                    </div>
                </div>

                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Status
                        </span>
                        <strong>@Model.Session.Status</strong>
                    </div>
                </div>

                <div class="col-6 col-md-4">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Interview Duration
                        </span>
                        <strong>
                            @TimeSpan.FromSeconds(Math.Max(0, Model.Session.ActiveDurationSeconds)).ToString(@"hh\:mm\:ss")
                        </strong>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Started At (UTC)
                        </span>
                        <strong>
                            @Model.Session.StartedAt.ToString(
                                "dd MMM yyyy HH:mm")
                        </strong>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="interview-results-stat">
                        <span class="interview-results-stat-label">
                            Completed At (UTC)
                        </span>
                        <strong>
                            @(Model.Session.CompletedAt?.ToString(
                                "dd MMM yyyy HH:mm") ?? "Not available")
                        </strong>
                    </div>
                </div>

            </div>
        </div>

        <!-- =====================================
             QUESTION-BY-QUESTION REVIEW
             ===================================== -->
        <div class="interview-results-section-heading">

            <h2>Question-by-Question Review</h2>

            <p>
                Review all interview questions, including
                those you skipped during your session.
            </p>
        </div>

        @if (Model.Questions == null || !Model.Questions.Any())
        {
            <div class="alert alert-info" role="status">
                No interview questions were found for this session.
            </div>
        }
        else
        {
            @foreach (var question in Model.Questions)
            {
                <article class="interview-result-question-card">

                    <div class="interview-result-question-top">

                        <span class="interview-result-question-number">
                            Question @question.QuestionNumber
                            of @totalQuestions
                        </span>

                        <div class="d-flex flex-wrap gap-2 align-items-center">

                            @if (!string.IsNullOrWhiteSpace(
                                question.DifficultyLevel))
                            {
                                <span class="interview-result-difficulty">
                                    @question.DifficultyLevel
                                </span>
                            }

                            @if (question.IsAnswered)
                            {
                                <span class="badge bg-success">
                                    Answered
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Skipped
                                </span>
                            }

                        </div>
                    </div>

                    <h3 class="interview-result-question-text">
                        @question.QuestionText
                    </h3>

                    <!-- USER ANSWER -->
                    <div class="interview-result-answer-block">

                        <h4 class="interview-result-user-answer-title">
                            Your Answer
                        </h4>

                        @if (question.IsAnswered)
                        {
                            <div class="interview-result-answer-text user-answer">
                                @question.AnswerText
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0"
                                 role="status">
                                You skipped this question.
                                No answer was submitted.
                            </div>
                        }

                    </div>

                    <!-- SUGGESTED ANSWER -->
                    <div class="interview-result-answer-block">

                        <h4 class="interview-result-suggested-title">
                            Suggested Answer
                        </h4>

                        @if (!string.IsNullOrWhiteSpace(
                            question.SuggestedAnswer))
                        {
                            <div class="interview-result-answer-text suggested-answer">
                                @question.SuggestedAnswer
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No suggested answer is available
                                for this question.
                            </p>
                        }

                    </div>

                    <!-- ASSESSMENT FEEDBACK -->
                    @if (question.IsAnswered)
                    {
                        <div class="interview-result-answer-block">
                            <h4 class="interview-result-suggested-title">
                                Assessment Feedback
                            </h4>

                            @if (question.AssessmentFeedback != null)
                            {
                                var feedback = question.AssessmentFeedback;

                                <p class="text-muted mb-3">
                                    <strong>Status:</strong> @feedback.AssessmentStatus
                                </p>

                                <h5 class="fs-6">Detected Concepts</h5>
                                @if (feedback.DetectedConcepts.Any())
                                {
                                    <ul>
                                        @foreach (var concept in feedback.DetectedConcepts)
                                        {
                                            <li>@concept</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted">No expected phrases were detected.</p>
                                }

                                <h5 class="fs-6">Concepts to Review</h5>
                                @if (feedback.ConceptsToReview.Any())
                                {
                                    <ul>
                                        @foreach (var concept in feedback.ConceptsToReview)
                                        {
                                            <li>@concept</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted">All listed expected phrases were detected.</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(feedback.ImprovementGuidance))
                                {
                                    <h5 class="fs-6">Improvement Guidance</h5>
                                    <p>@feedback.ImprovementGuidance</p>
                                }

                                @if (feedback.RequiresManualReview)
                                {
                                    <p class="text-muted small mb-0">
                                        @feedback.ReviewReason
                                        Phrase detection does not verify correctness or understanding.
                                    </p>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">
                                    Assessment feedback is not available for this answer.
                                </p>
                            }
                        </div>
                    }

                    <!-- SUBMISSION DATE -->
                    @if (question.SubmittedAt.HasValue)
                    {
                        <p class="interview-result-submitted-date">
                            Submitted:
                            @question.SubmittedAt.Value.ToString(
                                "dd MMM yyyy HH:mm") UTC
                        </p>
                    }

                </article>
            }
        }

        <!-- =====================================
             NEXT ACTIONS
             ===================================== -->

        <div class="interview-results-actions">

            @if (isCompleted && skippedQuestions > 0)
            {
                <form asp-controller="InterviewSessions"
                      asp-action="Reopen"
                      asp-route-id="@Model.Session.Id"
                      method="post"
                      onsubmit="return confirm('You have @skippedQuestions unanswered question(s). Reopen this interview to finish them? Your existing answers will be preserved.');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success interview-results-primary-button">
                        Resume Skipped Questions
                    </button>
                </form>
            }

            <a asp-controller="InterviewCategories"
               asp-action="Details"
               asp-route-id="@Model.Session.InterviewCategoryId"
               class="btn btn-primary interview-results-primary-button">
                Back to Category
            </a>

            <a asp-controller="InterviewSessions"
               asp-action="Details"
               asp-route-id="@Model.Session.Id"
               class="btn btn-outline-secondary interview-results-secondary-button">
                Back to Session
            </a>


        </div>


        <!-- =====================================
             PREPARATION REMINDER
             ===================================== -->
        <aside class="interview-results-tip">

            <span aria-hidden="true">💡</span>

            <div>
                <h2>Keep Improving</h2>

                <p>
                    Interview preparation is a continuous
                    process. Review your answers, identify
                    areas for improvement and practise
                    regularly to build confidence.
                </p>
            </div>

        </aside>

    </div>

</section>
