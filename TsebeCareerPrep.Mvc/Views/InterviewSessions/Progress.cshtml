@model TsebeCareerPrep.Mvc.Models.InterviewProgressViewModel

@{
    ViewData["Title"] = "Interview Progress";

    var completionRate = Math.Clamp(
        Model.CompletionRate, 0, 100);

    var completionRateValue = completionRate.ToString(
        System.Globalization.CultureInfo.InvariantCulture);
}

<section class="interview-progress-page">

    <!-- =====================================
         PROGRESS HEADER
         ===================================== -->

    <div class="interview-progress-header">

        <p class="interview-progress-eyebrow">
            YOUR CAREER JOURNEY
        </p>

        <h1>Interview Progress</h1>

        <p class="interview-progress-introduction">
            Track your interview practice activity,
            review your achievements and continue
            developing your interview confidence.
        </p>

        <div class="interview-progress-header-summary">

            <div class="interview-progress-header-stat">
                <strong>@Model.TotalInterviews</strong>
                <span>Total Interviews</span>
            </div>

            <div class="interview-progress-header-stat">
                <strong>@Model.CompletedInterviews</strong>
                <span>Completed</span>
            </div>

            <div class="interview-progress-header-stat">
                <strong>@completionRate.ToString("0.0")%</strong>
                <span>Completion Rate</span>
            </div>

        </div>

    </div>


    <!-- =====================================
         PROGRESS CONTENT
         ===================================== -->

    <div class="interview-progress-content">

        <div class="interview-progress-section-heading">

            <h2>Your Interview Activity</h2>

            <p>
                An overview of your interview preparation
                and completed practice sessions.
            </p>

        </div>


        <!-- Interview statistics -->

        <div class="row g-3 mb-4">

            <div class="col-6 col-lg-3">

                <div class="interview-progress-stat-card">

                    <span class="interview-progress-stat-label">
                        Total Interviews
                    </span>

                    <strong class="interview-progress-stat-number">
                        @Model.TotalInterviews
                    </strong>

                </div>

            </div>

            <div class="col-6 col-lg-3">

                <div class="interview-progress-stat-card">

                    <span class="interview-progress-stat-label">
                        Completed Interviews
                    </span>

                    <strong class="interview-progress-stat-number completed">
                        @Model.CompletedInterviews
                    </strong>

                </div>

            </div>

            <div class="col-6 col-lg-3">

                <div class="interview-progress-stat-card">

                    <span class="interview-progress-stat-label">
                        Interviews In Progress
                    </span>

                    <strong class="interview-progress-stat-number in-progress">
                        @Model.InProgressInterviews
                    </strong>

                </div>

            </div>

            <div class="col-6 col-lg-3">

                <div class="interview-progress-stat-card">

                    <span class="interview-progress-stat-label">
                        Total Answers Submitted
                    </span>

                    <strong class="interview-progress-stat-number answers">
                        @Model.TotalAnswers
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================
             COMPLETION RATE
             ===================================== -->

        <div class="interview-progress-completion-card">

            <div class="interview-progress-completion-heading">

                <div>

                    <h2>Interview Completion Rate</h2>

                    <p>
                        Your completed interview sessions
                        compared with your total sessions.
                    </p>

                </div>

                <strong class="interview-progress-percentage-value">
                    @completionRate.ToString("0.0")%
                </strong>

            </div>

            <div class="interview-progress-bar-track"
                 role="progressbar"
                 aria-label="Interview completion rate"
                 aria-valuenow="@completionRateValue"
                 aria-valuemin="0"
                 aria-valuemax="100">

                <div class="interview-progress-bar-fill"
                     style="width: @(completionRateValue)%;">
                </div>

            </div>

            <p class="interview-progress-completion-note">
                @Model.CompletedInterviews of
                @Model.TotalInterviews interview sessions completed.
            </p>

        </div>


        <!-- =====================================
             CONTINUE PREPARATION
             ===================================== -->

        <div class="interview-progress-next-card">

            <div>

                <h2>Continue Your Interview Preparation</h2>

                <p>
                    Every practice session is an opportunity
                    to strengthen your skills. Start a new
                    interview or continue an unfinished session.
                </p>

            </div>

            <div class="interview-progress-actions">

                <a asp-controller="InterviewCategories"
                   asp-action="Index"
                   class="btn btn-primary interview-progress-primary-button">

                    Start New Interview

                </a>

                <a asp-controller="InterviewSessions"
                   asp-action="History"
                   class="btn btn-outline-secondary interview-progress-secondary-button">

                    View Previous Interviews

                </a>

            </div>

        </div>


        <!-- Preparation reminder -->

        <aside class="interview-progress-tip">

            <span aria-hidden="true">💡</span>

            <div>

                <h2>Keep Building Your Confidence</h2>

                <p>
                    Consistent practice helps you become
                    more familiar with interview questions.
                    Review your previous answers and continue
                    preparing for future career opportunities.
                </p>

            </div>

        </aside>

    </div>

</section>
