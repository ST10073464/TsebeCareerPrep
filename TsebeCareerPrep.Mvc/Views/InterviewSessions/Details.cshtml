@model TsebeCareerPrep.Mvc.Models.InterviewSessionViewModel

@{
    ViewData["Title"] = "Interview Session";

    var isInProgress = Model.Status == "InProgress";
    var isCompleted = Model.Status == "Completed";
}

<section class="interview-session-page">

    <header class="interview-session-header">

        <a asp-controller="InterviewCategories"
           asp-action="Index"
           class="interview-back-link">
            ← Back to Categories
        </a>

        <p class="interview-session-eyebrow">
            YOUR INTERVIEW JOURNEY
        </p>

        <h1>Interview Session</h1>

        <p class="interview-session-introduction">
            Review your interview details and continue
            preparing for your next career opportunity.
        </p>

        <div class="interview-session-header-badges">

            <span class="interview-session-category-pill">
                @Model.CategoryName
            </span>

            @if (isInProgress)
            {
                <span class="interview-session-status-pill in-progress">
                    In Progress
                </span>
            }
            else if (isCompleted)
            {
                <span class="interview-session-status-pill completed">
                    Completed
                </span>
            }
            else
            {
                <span class="interview-session-status-pill">
                    @Model.Status
                </span>
            }

        </div>

    </header>

    <div class="interview-session-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["Error"]
            </div>
        }

        <div class="interview-session-details-card">

            <div class="interview-session-section-heading">
                <h2>Session Overview</h2>
                <p>
                    Your interview practice information.
                </p>
            </div>

            <div class="interview-session-details-grid">

                <div class="interview-session-detail-item">
                    <span>Session Reference</span>
                    <strong>#@Model.Id</strong>
                </div>

                <div class="interview-session-detail-item">
                    <span>Interview Category</span>
                    <strong>@Model.CategoryName</strong>
                </div>

                <div class="interview-session-detail-item">
                    <span>Started At (UTC)</span>
                    <strong>
                        @Model.StartedAt.ToString("dd MMM yyyy HH:mm")
                    </strong>
                </div>

                <div class="interview-session-detail-item">
                    <span>Current Status</span>

                    @if (isInProgress)
                    {
                        <strong class="interview-session-status-text in-progress">
                            In Progress
                        </strong>
                    }
                    else if (isCompleted)
                    {
                        <strong class="interview-session-status-text completed">
                            Completed
                        </strong>
                    }
                    else
                    {
                        <strong>@Model.Status</strong>
                    }

                </div>

                @if (Model.CompletedAt.HasValue)
                {
                    <div class="interview-session-detail-item">
                        <span>Completed At (UTC)</span>
                        <strong>
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                        </strong>
                    </div>
                }

            </div>

        </div>

        @if (isInProgress)
        {
            <div class="interview-session-action-card">

                <div class="interview-session-action-heading">
                    <span class="interview-session-action-icon"
                          aria-hidden="true">🎯</span>

                    <div>
                        <h2>Continue Your Interview</h2>

                        <p>
                            Your interview is currently active.
                            Continue answering questions at your own pace.
                        </p>
                    </div>
                </div>

                <div class="interview-session-actions">

                    <a asp-controller="InterviewSessions"
                       asp-action="Questions"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary interview-session-primary-button">
                        Continue Interview
                    </a>

                    <form asp-controller="InterviewSessions"
                          asp-action="Complete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to complete this interview? You will not be able to submit additional answers.');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-success interview-session-secondary-button">
                            Complete Interview
                        </button>

                    </form>

                </div>

                <p class="interview-session-action-note">
                    Complete your interview when you are ready to
                    review your results. At least one answer must
                    be submitted before completion.
                </p>

            </div>
        }
        else if (isCompleted)
        {
            <div class="interview-session-action-card completed">

                <div class="interview-session-action-heading">

                    <span class="interview-session-action-icon"
                          aria-hidden="true">✓</span>

                    <div>
                        <h2>Interview Completed!</h2>

                        <p>
                            Well done on completing your interview.
                            Review your submitted answers alongside
                            the suggested answers to identify
                            opportunities for improvement.
                        </p>
                    </div>

                </div>

                <div class="interview-session-actions">

                    <a asp-controller="InterviewSessions"
                       asp-action="Results"
                       asp-route-id="@Model.Id"
                       class="btn btn-success interview-session-primary-button">
                        View Interview Results
                    </a>

                    <a asp-controller="InterviewCategories"
                       asp-action="Index"
                       class="btn btn-outline-primary interview-session-secondary-button">
                        Start Another Interview
                    </a>

                </div>

            </div>
        }

    </div>

</section>
