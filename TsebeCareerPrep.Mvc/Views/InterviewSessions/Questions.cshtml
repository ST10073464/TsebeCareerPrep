@model TsebeCareerPrep.Mvc.Models.InterviewSessionQuestionsViewModel

@{
    ViewData["Title"] = "Interview Questions";

    var questions = Model.Questions?.ToList()
        ?? new List<TsebeCareerPrep.Mvc.Models.InterviewSessionQuestionViewModel>();

    var totalQuestions = questions.Count;
    var answeredQuestions = questions.Count(q => q.IsAnswered);

    var progressPercentage = totalQuestions > 0
        ? (int)Math.Round(answeredQuestions * 100.0 / totalQuestions)
        : 0;

    var isInProgress = Model.Status == "InProgress";
}

<section class="interview-questions-page">

    <!-- INTERVIEW HEADER -->

    <div class="interview-questions-header">
       
        <div class="d-flex justify-content-end mb-3">

            @if (isInProgress)
            {
                
            <form asp-controller="InterviewSessions"
                  asp-action="Exit"
                  asp-route-id="@Model.SessionId"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-secondary">
                    Exit Interview
                </button>

            </form>

            }

        </div>

        @if (isInProgress)
        {
            <form asp-controller="InterviewSessions"
                  asp-action="Exit"
                  asp-route-id="@Model.SessionId"
                  method="post"
                  class="mb-3">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="interview-back-link border-0 bg-transparent p-0">
                    &#8592; Back to My Interviews
                </button>
            </form>
        }
        else
        {
            <a asp-controller="InterviewSessions"
               asp-action="Options"
               asp-route-id="@Model.SessionId"
               class="interview-back-link">
                &#8592; Back to Interview Options
            </a>
        }
       
      

        <p class="interview-questions-eyebrow">
            INTERVIEW PRACTICE
        </p>

        <h1>@Model.CategoryName Interview</h1>

        <p class="interview-session-reference">
            Session #@Model.SessionId
        </p>

        
        <div class="mt-3 mb-3"
             role="timer"
             aria-label="Elapsed interview time">

            <div class="d-flex flex-wrap align-items-center gap-3">

                <div>
                    <p class="mb-1 small">
                        Interview Duration
                    </p>

                    <div id="interviewTimer"
                         class="fs-3 fw-bold font-monospace"
                         data-elapsed-seconds="@Model.ActiveDurationSeconds"
                         data-running="@Model.IsTimerRunning.ToString().ToLowerInvariant()"
                         data-started-at="@Model.TimerStartedAtUtc?.ToString("O")"
                         data-last-heartbeat="@Model.LastTimerHeartbeatUtc?.ToString("O")"
                         data-heartbeat-url="@Url.Action("Heartbeat", "InterviewSessions", new { id = Model.SessionId })">
                        @TimeSpan.FromSeconds(
                            Model.ActiveDurationSeconds
                        ).ToString(@"hh\:mm\:ss")
                    </div>
                </div>

                <span id="interviewTimerStatus"
                      class="badge @(Model.IsTimerRunning ? "bg-success" : "bg-secondary")">
                    @(Model.IsTimerRunning ? "Running" : "Paused")
                </span>

            </div>

        </div>



        <div class="interview-header-status">
            <span class="interview-status-pill @(isInProgress ? "in-progress" : "completed")">
                @(isInProgress ? "In Progress" : Model.Status)
            </span>
        </div>

        <div class="interview-progress-summary">

            <div class="interview-progress-labels">
                <span>Interview Progress</span>
                <span>@answeredQuestions of @totalQuestions answered</span>
            </div>

            <div class="interview-progress-track"
                 role="progressbar"
                 aria-label="Interview questions answered"
                 aria-valuenow="@answeredQuestions"
                 aria-valuemin="0"
                 aria-valuemax="@totalQuestions">

                <div class="interview-progress-fill"
                     style="width: @(progressPercentage)%;">
                </div>

            </div>

            <p class="interview-progress-percentage">
                @progressPercentage% complete
            </p>

        </div>

    </div>

    <!-- QUESTION CONTENT -->

    <div class="interview-questions-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["Error"]
            </div>
        }

        @if (totalQuestions == 0)
        {
            <div class="alert alert-info" role="status">
                No interview questions are currently available.
            </div>
        }
        else
        {
            <div class="interview-question-navigator">

                <div class="d-flex justify-content-between
                    align-items-center gap-2 mb-3">

                    <h2 class="h5 fw-bold mb-0"
                        id="currentQuestionNumber">
                        Question 1 of @totalQuestions
                    </h2>

                    <span class="badge bg-primary">
                        @totalQuestions Questions
                    </span>

                </div>

                @for (var i = 0; i < totalQuestions; i++)
                {
                    var question = questions[i];


                    <article class="interview-question-card"
                             data-question-index="@i"
                             data-question-id="@question.Id"
                             data-answered="@question.IsAnswered.ToString().ToLowerInvariant()"
                             hidden="@(i != 0 ? "hidden" : null)">


                        <div class="interview-question-card-top">

                            <span class="interview-question-number">
                                Question @(i + 1)
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                question.DifficultyLevel))
                            {
                                <span class="interview-question-difficulty">
                                    @question.DifficultyLevel
                                </span>
                            }

                        </div>

                        <h3 class="interview-question-text">
                            @question.QuestionText
                        </h3>

                        <div class="interview-question-card-footer">

                            @if (question.IsAnswered)
                            {
                                <span class="interview-question-state answered">
                                    &#10003; Answered
                                </span>

                                <button type="button"
                                        class="btn btn-outline-success"
                                        disabled>
                                    Already Answered
                                </button>
                            }
                            else if (isInProgress)
                            {
                                <span class="interview-question-state pending">
                                    Not Answered
                                </span>

                                <a asp-controller="InterviewSessions"
                                   asp-action="Answer"
                                   asp-route-sessionId="@Model.SessionId"
                                   asp-route-questionId="@question.Id"
                                   class="btn btn-primary interview-question-button">

                                    Answer Question

                                </a>
                            }
                            else
                            {
                                <span class="interview-question-state unavailable">
                                    Not Answered
                                </span>

                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled>
                                    Session Completed
                                </button>
                            }

                        </div>

                    </article>
                }


                @if (isInProgress)
                {
                    <div class="mt-4 pt-3 border-top">

                        <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center gap-3">

                            <div>
                                <h3 class="h5 fw-bold mb-1">
                                    Ready to finish?
                                </h3>

                                <p class="text-muted mb-0">
                                    You have answered
                                    <strong>@answeredQuestions of @totalQuestions</strong>
                                    questions.
                                </p>
                            </div>

                            <form id="completeInterviewForm"
                                  asp-controller="InterviewSessions"
                                  asp-action="Complete"
                                  asp-route-id="@Model.SessionId"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        id="openCompleteInterviewDialog"
                                        class="btn btn-success"
                                        disabled="@(answeredQuestions == 0)">
                                    Complete Interview
                                </button>
                            </form>

                        </div>

                        <dialog id="completeInterviewDialog"
                                aria-labelledby="completeInterviewTitle"
                                aria-describedby="completeInterviewDescription"
                                style="border:0;border-radius:14px;max-width:min(92vw,500px);width:100%;padding:0;box-shadow:0 16px 55px rgba(0,0,0,.25);">
                            <div class="p-4">
                                <h2 id="completeInterviewTitle" class="h4 fw-bold mb-3">
                                    Complete this interview?
                                </h2>
                                <p id="completeInterviewDescription" class="mb-3">
                                    You have answered <strong>@answeredQuestions of @totalQuestions</strong> questions.
                                </p>
                                @if (answeredQuestions < totalQuestions)
                                {
                                    <div class="alert alert-warning" role="note">
                                        <strong>@(totalQuestions - answeredQuestions) question(s) remain unanswered.</strong>
                                        You can return to them before completing.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success" role="note">
                                        All questions have been answered.
                                    </div>
                                }
                                <p class="text-muted small">
                                    Completing the interview is final. You will not be able to submit additional answers.
                                </p>
                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                                    <button type="button" id="cancelCompleteInterview"
                                            class="btn btn-outline-secondary"
                                            disabled="@(totalQuestions > 0 && answeredQuestions == totalQuestions)"
                                            title="@(totalQuestions > 0 && answeredQuestions == totalQuestions ? "All questions have been answered" : "Return to unanswered questions")">
                                        Continue Interviewing
                                    </button>
                                    <button type="submit" form="completeInterviewForm"
                                            id="confirmCompleteInterview"
                                            class="btn btn-success">
                                        Complete Interview
                                    </button>
                                </div>
                            </div>
                        </dialog>

                        @if (answeredQuestions == 0)
                        {
                            <p class="text-muted small mt-2">
                                Submit at least one answer before completing
                                this interview.
                            </p>
                        }

                    </div>
                }

                
<!-- QUESTION OVERVIEW -->
<div class="card shadow-sm mt-4 mb-3">
    <div class="card-body">
        <h3 class="h5 fw-bold mb-2">
            Question Overview
        </h3>

        <p class="text-muted small mb-3">
            Select a question number to jump directly to it.
        </p>

        <div class="d-flex flex-wrap gap-2"
             id="interviewQuestionOverview"
             role="group"
             aria-label="Jump to an interview question">

            @for (var i = 0; i < totalQuestions; i++)
            {
                var item = questions[i];

                <button type="button"
                        class="btn @(item.IsAnswered
                            ? "btn-outline-success"
                            : "btn-outline-secondary")"
                        data-jump-index="@i"
                        aria-label="Question @(i + 1), @(item.IsAnswered ? "answered" : "unanswered")">
                    @(i + 1)
                    @if (item.IsAnswered)
                    {
                        <span aria-hidden="true">&#10003;</span>
                    }
                </button>
            }
        </div>

        <div class="d-flex flex-wrap gap-3 mt-3 small">
            <span class="text-success">✓ Answered</span>
            <span class="text-primary">● Current</span>
            <span class="text-muted">○ Unanswered</span>
        </div>
    </div>
</div>



                <!-- QUESTION NAVIGATION -->

                <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mt-4">

                    <button type="button"
                            id="previousQuestionButton"
                            class="btn btn-outline-secondary"
                            disabled>
                        &#8592; Previous
                    </button>

                    <button type="button"
                            id="nextQuestionButton"
                            class="btn btn-primary">
                        Next / Skip &#8594;
                    </button>

                </div>

                <p class="text-muted small mt-3"
                   id="questionNavigationHint"
                   aria-live="polite">
                    You can skip a question and return to it later.
                </p>

            </div>
        }

    </div>

</section>


@section Scripts {
    <form id="interviewTimerSecurityForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/js/interview-timer.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dialog = document.getElementById("completeInterviewDialog");
            const openButton = document.getElementById("openCompleteInterviewDialog");
            const cancelButton = document.getElementById("cancelCompleteInterview");
            const completeForm = document.getElementById("completeInterviewForm");
            const confirmButton = document.getElementById("confirmCompleteInterview");

            if (dialog && openButton && cancelButton && completeForm && confirmButton) {
                openButton.addEventListener("click", function () {
                    dialog.showModal();
                });
                cancelButton.addEventListener("click", function () {
                    dialog.close();
                    openButton.focus();
                });
                dialog.addEventListener("click", function (event) {
                    if (event.target === dialog) dialog.close();
                });
                completeForm.addEventListener("submit", function () {
                    confirmButton.disabled = true;
                    confirmButton.textContent = "Completing...";
                });
            }
        });

        document.addEventListener("DOMContentLoaded", function () {

            const cards = Array.from(
                document.querySelectorAll(
                    ".interview-question-navigator [data-question-index]"
                )
            );

            if (cards.length === 0) {
                return;
            }

            const previousButton = document.getElementById(
                "previousQuestionButton"
            );

            const nextButton = document.getElementById(
                "nextQuestionButton"
            );

            const questionNumber = document.getElementById(
                "currentQuestionNumber"
            );

            const hint = document.getElementById(
                "questionNavigationHint"
            );

            const parameters = new URLSearchParams(
                window.location.search
            );

            const requestedQuestion = Number.parseInt(
                parameters.get("question") || "1",
                10
            );

            const answeredQuestionId = Number.parseInt(
                parameters.get("answeredQuestionId") || "0",
                10
            );

            let currentIndex = 0;

            // Priority 1: Continue after a submitted answer.
            if (answeredQuestionId > 0) {

                const answeredIndex = cards.findIndex(
                    card => Number(card.dataset.questionId)
                        === answeredQuestionId
                );

                if (answeredIndex >= 0) {

                    // Find the next unanswered question,
                    // starting after the question just submitted.
                    let nextUnansweredIndex = -1;

                    for (let i = answeredIndex + 1;
                        i < cards.length; i++) {

                        if (cards[i].dataset.answered === "false") {
                            nextUnansweredIndex = i;
                            break;
                        }
                    }

                    // If necessary, search earlier questions
                    // that the user skipped.
                    if (nextUnansweredIndex === -1) {

                        for (let i = 0;
                            i < answeredIndex; i++) {

                            if (cards[i].dataset.answered === "false") {
                                nextUnansweredIndex = i;
                                break;
                            }
                        }
                    }

                    currentIndex = nextUnansweredIndex >= 0
                        ? nextUnansweredIndex
                        : answeredIndex;
                }
            }

            // Priority 2: Respect manual question navigation.
else if (parameters.has("question")
    && Number.isFinite(requestedQuestion)) {

    currentIndex = Math.min(
        Math.max(requestedQuestion - 1, 0),
        cards.length - 1
    );
}

// Priority 3: Resume at the first unanswered question.
else {

    const firstUnansweredIndex = cards.findIndex(
        card => card.dataset.answered === "false"
    );

    currentIndex = firstUnansweredIndex >= 0
        ? firstUnansweredIndex
        : 0;
}


            const overviewButtons = Array.from(document.querySelectorAll(
                "#interviewQuestionOverview [data-jump-index]"
            ));

            function showQuestion(index) {
                currentIndex = Math.min(
                    Math.max(index, 0),
                    cards.length - 1
                );

                cards.forEach(function (card, position) {
                    card.hidden = position !== currentIndex;
                });

                overviewButtons.forEach(function (button) {
                    const buttonIndex = Number(button.dataset.jumpIndex);
                    const isCurrent = buttonIndex === currentIndex;
                    const isAnswered =
                        cards[buttonIndex]?.dataset.answered === "true";

                    button.classList.toggle("btn-primary", isCurrent);
                    button.classList.toggle(
                        "btn-outline-success", !isCurrent && isAnswered
                    );
                    button.classList.toggle(
                        "btn-outline-secondary", !isCurrent && !isAnswered
                    );
                    if (isCurrent) {
                        button.setAttribute("aria-current", "step");
                    } else {
                        button.removeAttribute("aria-current");
                    }
                });

                questionNumber.textContent =
                    `Question ${currentIndex + 1} of ${cards.length}`;

                previousButton.disabled = currentIndex === 0;

                nextButton.disabled =
                    currentIndex === cards.length - 1;

                nextButton.textContent =
                    currentIndex === cards.length - 1
                        ? "Last Question"
                        : "Next / Skip →";

                hint.textContent =
                    currentIndex === cards.length - 1
                        ? "You have reached the last question. You can return to earlier questions."
                        : "You can skip a question and return to it later.";

                const url = new URL(window.location.href);

                url.searchParams.delete("answeredQuestionId");

                url.searchParams.set(
                    "question",
                    String(currentIndex + 1)
                );

                window.history.replaceState(
                    null,
                    "",
                    url.pathname + url.search + url.hash
                );
            }

            
document.querySelectorAll(
    "#interviewQuestionOverview [data-jump-index]"
).forEach(function (button) {
    button.addEventListener("click", function () {
        const index = Number(button.dataset.jumpIndex);

        if (!Number.isInteger(index) ||
            index < 0 ||
            index >= cards.length) {
            return;
        }

        showQuestion(index);

        const activeCard = cards[index];

        activeCard.scrollIntoView({
            behavior: window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches ? "auto" : "smooth",
            block: "center"
        });
    });
});


            previousButton.addEventListener("click", function () {
                showQuestion(currentIndex - 1);
            });

            nextButton.addEventListener("click", function () {
                showQuestion(currentIndex + 1);
            });

           
showQuestion(currentIndex);

// After a successful answer submission, draw attention
// to the next unanswered question.
if (answeredQuestionId > 0 &&
    cards[currentIndex].dataset.answered === "false") {

    const nextQuestion = cards[currentIndex];

    if (window.TsebeChangeHighlighter) {
        window.TsebeChangeHighlighter.highlight(
            nextQuestion,
            "status"
        );
    } else {
        nextQuestion.classList.add("tcp-highlight-status");

        nextQuestion.scrollIntoView({
            behavior: window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches ? "auto" : "smooth",
            block: "center"
        });

        window.setTimeout(function () {
            nextQuestion.classList.remove(
                "tcp-highlight-status"
            );
        }, 5000);
    }
}

        });
    </script>
}
