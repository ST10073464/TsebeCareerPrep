@model List<TsebeCareerPrep.Mvc.Models.InterviewHistoryViewModel>

@{
    ViewData["Title"] = "My Interviews";

    var sessions = Model
        ?? new List<TsebeCareerPrep.Mvc.Models.InterviewHistoryViewModel>();

    var categoryGroups = sessions
        .GroupBy(s => s.InterviewCategoryId)
        .OrderBy(g => g.First().CategoryName)
        .ToList();

    var totalSessions = sessions.Count;

    var completedSessions = sessions.Count(
        s => s.Status == "Completed");

    var inProgressSessions = sessions.Count(
        s => s.Status == "InProgress");
}

<section class="interview-history-page">

    <!-- Page header -->
    <div class="interview-history-header">

        <p class="interview-history-eyebrow">
            YOUR CAREER JOURNEY
        </p>

        <h1>My Interviews</h1>

        <p class="interview-history-introduction">
            Manage your interview preparation by category,
            review previous attempts and track your progress.
        </p>

        <div class="interview-history-header-stats">

            <div class="interview-history-header-stat">
                <strong>@categoryGroups.Count</strong>
                <span>Categories</span>
            </div>

            <div class="interview-history-header-stat">
                <strong>@completedSessions</strong>
                <span>Completed</span>
            </div>

            <div class="interview-history-header-stat">
                <strong>@inProgressSessions</strong>
                <span>In Progress</span>
            </div>

        </div>
    </div>

    <!-- Page content -->
    <div class="interview-history-content">

        <div class="interview-history-toolbar">

            <div>
                <h2>Your Interview Categories</h2>
                <p>
                    @totalSessions interview
                    @(totalSessions == 1 ? "attempt" : "attempts")
                    across @categoryGroups.Count
                    @(categoryGroups.Count == 1 ? "category" : "categories").
                </p>
            </div>

            <a asp-controller="InterviewCategories"
               asp-action="Index"
               class="btn btn-primary interview-history-new-button">
                Explore Categories
            </a>

        </div>

        @if (!categoryGroups.Any())
        {
            <div class="interview-history-empty">

                <div class="interview-history-empty-icon"
                     aria-hidden="true">
                    📋
                </div>

                <h3>No Interviews Yet</h3>

                <p>
                    Explore an interview category to begin
                    your career preparation.
                </p>

                <a asp-controller="InterviewCategories"
                   asp-action="Index"
                   class="btn btn-primary interview-history-new-button">
                    Explore Categories
                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var group in categoryGroups)
                {
                    var attempts = group
                        .OrderByDescending(s => s.StartedAt)
                        .ThenByDescending(s => s.Id)
                        .ToList();

                    var activeAttempt = attempts.FirstOrDefault(
                        s => s.Status == "InProgress");

                    var completedCount = attempts.Count(
                        s => s.Status == "Completed");

                    var archivedCount = attempts.Count(
                        s => s.Status == "Abandoned"
                          || s.Status == "Cancelled"
                          || s.Status == "Restarted");

                    var statusText = activeAttempt != null
                        ? "In Progress"
                        : completedCount > 0
                            ? "Completed"
                            : "Archived";

                    var statusClass = activeAttempt != null
                        ? "in-progress"
                        : completedCount > 0
                            ? "completed"
                            : "";

                    <div class="col-12 col-xl-6"
                         id="category-@group.Key">

                        <article class="interview-history-card h-100">

                            <div class="interview-history-card-top">

                                <h3>@group.First().CategoryName</h3>

                                <span class="interview-history-status @statusClass">
                                    @statusText
                                </span>

                            </div>

                            <p class="interview-history-session-id">
                                @attempts.Count
                                @(attempts.Count == 1 ? "attempt" : "attempts")
                                recorded
                            </p>

                            <!-- Category summary -->
                            <div class="interview-history-card-details">

                                <div class="interview-history-detail">
                                    <span>Completed</span>
                                    <strong>@completedCount</strong>
                                </div>

                                <div class="interview-history-detail">
                                    <span>In Progress</span>
                                    <strong>
                                        @(activeAttempt == null ? 0 : 1)
                                    </strong>
                                </div>

                                <div class="interview-history-detail">
                                    <span>Archived</span>
                                    <strong>@archivedCount</strong>
                                </div>

                            </div>

                            <!-- Expandable interview attempts -->
                            <details class="mt-3 mb-3">

                                <summary class="fw-semibold"
                                         style="cursor:pointer;">
                                    View All Attempts (@attempts.Count)
                                </summary>

                                <div class="mt-3">

                                    @foreach (var attempt in attempts)
                                    {
                                        var isCompleted =
                                            attempt.Status == "Completed";

                                        var isActive =
                                            attempt.Status == "InProgress";

                                        <div class="border rounded p-3 mb-2">

                                            <div class="d-flex flex-wrap
                                                justify-content-between
                                                align-items-center gap-2">

                                                <strong>
                                                    Session #@attempt.Id
                                                </strong>

                                                <span class="interview-history-status
                                                    @(isCompleted ? "completed" :
  isActive ? "in-progress" : "")">

                                                    @attempt.Status

                                                </span>

                                            </div>

                                            <p class="small text-muted mt-2 mb-2">
                                                Started (UTC):
                                                @attempt.StartedAt.ToString(
                                                    "dd MMM yyyy HH:mm")
                                                <br />
                                                Answers submitted:
                                                @attempt.TotalAnswered
                                                <br />
                                                Recorded duration:
                                                @TimeSpan.FromSeconds(Math.Max(0L, attempt.ActiveDurationSeconds)).ToString(@"hh\:mm\:ss")
                                            </p>

                                            @if (isCompleted)
                                            {
                                                <a asp-controller="InterviewSessions"
                                                   asp-action="Results"
                                                   asp-route-id="@attempt.Id"
                                                   class="btn btn-sm btn-outline-success">
                                                    View Results
                                                </a>
                                            }
                                            else if (isActive)
                                            {
                                                <a asp-controller="InterviewSessions"
                                                   asp-action="Options"
                                                   asp-route-id="@attempt.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Continue Interview
                                                </a>
                                            }

                                        </div>
                                    }

                                </div>

                            </details>

                            <!-- Category actions -->
                            <div class="interview-history-card-footer
                                d-flex flex-wrap gap-2">

                                
                                @if (activeAttempt != null)
                                {
                                    <a asp-controller="InterviewSessions"
                                       asp-action="Options"
                                       asp-route-id="@activeAttempt.Id"
                                       class="btn btn-primary interview-history-action">
                                        Interview Options
                                    </a>
                                }
                                else
                                {
                                    @* The category selection page uses the existing interview-start workflow. *@
                                    <a asp-controller="InterviewCategories"
                                       asp-action="Index"
                                       class="btn btn-primary interview-history-action"
                                       aria-label="Start a new interview in @group.First().CategoryName">
                                        Start New Interview
                                    </a>
                                }


                                <a asp-controller="InterviewQuestions"
                                   asp-action="Category"
                                   asp-route-id="@group.Key"
                                   class="btn btn-outline-primary interview-history-action">
                                    Review All Practice Questions
                                </a>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </div>

</section>
