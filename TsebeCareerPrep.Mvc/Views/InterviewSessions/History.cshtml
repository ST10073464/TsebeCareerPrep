@model List<TsebeCareerPrep.Mvc.Models.InterviewHistoryViewModel>

@{
    ViewData["Title"] = "Interview History";
}

<div class="container py-4 py-md-5">

    <div class="mb-4">
        <h1 class="fw-bold">Interview History</h1>

        <p class="text-muted">
            Review your previous interview sessions,
            continue practising, or view completed results.
        </p>
    </div>

    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">

        <div>
            <span class="badge bg-primary fs-6">
                @Model.Count Interview Sessions
            </span>
        </div>

        <a asp-controller="InterviewCategories"
           asp-action="Index"
           class="btn btn-primary">
            Start New Interview
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h4>No Interview History Yet</h4>

                <p class="text-muted">
                    Start your first practice interview
                    to begin tracking your progress.
                </p>

                <a asp-controller="InterviewCategories"
                   asp-action="Index"
                   class="btn btn-primary">
                    Start Interview
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var session in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between
                                align-items-start gap-2 mb-3">

                                <h5 class="card-title fw-bold mb-0">
                                    @session.CategoryName
                                </h5>

                                @if (session.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        In Progress
                                    </span>
                                }

                            </div>

                            <p class="text-muted small mb-3">
                                Session #@session.Id
                            </p>

                            <div class="mb-3">

                                <p class="mb-2">
                                    <strong>Answers Submitted:</strong>
                                    @session.TotalAnswered
                                </p>

                                <p class="mb-2">
                                    <strong>Started:</strong>
                                    @session.StartedAt.ToString(
                                        "dd MMM yyyy HH:mm") UTC
                                </p>

                                @if (session.CompletedAt.HasValue)
                                {
                                    <p class="mb-0">
                                        <strong>Completed:</strong>
                                        @session.CompletedAt.Value.ToString(
                                            "dd MMM yyyy HH:mm") UTC
                                    </p>
                                }

                            </div>

                            <div class="mt-auto pt-3">

                                @if (session.Status == "Completed")
                                {
                                    <a asp-controller="InterviewSessions"
                                       asp-action="Results"
                                       asp-route-id="@session.Id"
                                       class="btn btn-success w-100">
                                        View Results
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="InterviewSessions"
                                       asp-action="Questions"
                                       asp-route-id="@session.Id"
                                       class="btn btn-primary w-100">
                                        Continue Interview
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
