@model List<TsebeCareerPrep.Mvc.Models.InterviewHistoryViewModel>

@{
    ViewData["Title"] = "Interview History";

    var sessions = Model ?? new List<
        TsebeCareerPrep.Mvc.Models.InterviewHistoryViewModel>();

    var totalSessions = sessions.Count;

    var completedSessions = sessions.Count(
        s => s.Status == "Completed");

    var inProgressSessions = sessions.Count(
        s => s.Status != "Completed");
}

<section class="interview-history-page">

    <!-- =====================================
         INTERVIEW HISTORY HEADER
         ===================================== -->

    <div class="interview-history-header">

        <p class="interview-history-eyebrow">
            YOUR CAREER JOURNEY
        </p>

        <h1>Interview History</h1>

        <p class="interview-history-introduction">
            Review your previous interview sessions,
            continue practising and revisit completed
            results as you develop your interview skills.
        </p>

        <div class="interview-history-header-stats">

            <div class="interview-history-header-stat">
                <strong>@totalSessions</strong>
                <span>Total Sessions</span>
            </div>

            <div class="interview-history-header-stat">
                <strong>@completedSessions</strong>
                <span>Completed</span>
            </div>

            <div class="interview-history-header-stat">
                <strong>@inProgressSessions</strong>
                <span>In Progress</span>
            </div>

        </div>

    </div>


    <!-- =====================================
         INTERVIEW HISTORY CONTENT
         ===================================== -->

    <div class="interview-history-content">

        <div class="interview-history-toolbar">

            <div>
                <h2>Your Interview Sessions</h2>

                <p>
                    @totalSessions interview
                    @(totalSessions == 1 ? "session" : "sessions")
                    recorded.
                </p>
            </div>

            <a asp-controller="InterviewCategories"
               asp-action="Index"
               class="btn btn-primary interview-history-new-button">

                Start New Interview

            </a>

        </div>


        @if (totalSessions == 0)
        {
            <!-- Empty state -->

            <div class="interview-history-empty">

                <div class="interview-history-empty-icon"
                     aria-hidden="true">
                    📋
                </div>

                <h3>No Interview History Yet</h3>

                <p>
                    Start your first practice interview
                    to begin tracking your preparation
                    and progress.
                </p>

                <a asp-controller="InterviewCategories"
                   asp-action="Index"
                   class="btn btn-primary interview-history-new-button">

                    Start Interview

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var session in sessions)
                {
                    var isCompleted =
                        session.Status == "Completed";

                    <div class="col-12 col-md-6 col-xl-4">

                        <article class="interview-history-card h-100">

                            <div class="interview-history-card-top">

                                <h3>
                                    @session.CategoryName
                                </h3>

                                @if (isCompleted)
                                {
                                    <span class="interview-history-status completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="interview-history-status in-progress">
                                        In Progress
                                    </span>
                                }

                            </div>

                            <p class="interview-history-session-id">
                                Session #@session.Id
                            </p>

                            <div class="interview-history-card-details">

                                <div class="interview-history-detail">

                                    <span>Answers Submitted</span>

                                    <strong>
                                        @session.TotalAnswered
                                    </strong>

                                </div>

                                <div class="interview-history-detail">

                                    <span>Started (UTC)</span>

                                    <strong>
                                        @session.StartedAt.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </strong>

                                </div>

                                @if (session.CompletedAt.HasValue)
                                {
                                    <div class="interview-history-detail">

                                        <span>Completed (UTC)</span>

                                        <strong>
                                            @session.CompletedAt.Value.ToString(
                                                "dd MMM yyyy HH:mm")
                                        </strong>

                                    </div>
                                }

                            </div>

                            <div class="interview-history-card-footer">

                                @if (isCompleted)
                                {
                                    <a asp-controller="InterviewSessions"
                                       asp-action="Results"
                                       asp-route-id="@session.Id"
                                       class="btn btn-success interview-history-action">

                                        View Results

                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="InterviewSessions"
                                       asp-action="Questions"
                                       asp-route-id="@session.Id"
                                       class="btn btn-primary interview-history-action">

                                        Continue Interview

                                    </a>
                                }

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </div>

</section>
